

<Page xmlns="http://schemas.nativescript.org/tns.xsd"
      navigatingTo="onNavigatingTo">

    <ActionBar title="Personnalités algériennes" />

    <GridLayout rows="auto,*" padding="15">

        <Label row="0"
               text="Découvrez les personnalités algériennes"
               fontSize="20"
               fontWeight="bold"
               textWrap="true"
               textAlignment="center"
               marginBottom="15" />

        <ListView row="1"
                  items="{{ people }}"
                  itemTap="onPersonTap">

            <ListView.itemTemplate>
                <StackLayout padding="12">
                    <Label text="{{ name }}"
                           fontSize="18"
                           fontWeight="bold" />
                </StackLayout>
            </ListView.itemTemplate>

        </ListView>

    </GridLayout>
</Page>


