# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais publié.
# Les valeurs viennent du tableau de bord Supabase : Project Settings > API.

SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=cle-publique-anon
# Clé de service : uniquement côté serveur, jamais dans l'application mobile ni le site
SUPABASE_SERVICE_ROLE_KEY=cle-secrete-ne-pas-partager

# Vérification anti-robots (section 50)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Paiements : mode simulation tant que SANKOVEYA n'a pas choisi de prestataire (section 34)
PAYMENT_MODE=simulation
