rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    // ==========================================
    // UTILISATEURS
    // ==========================================

    match /users/{userId} {

      allow read: if isSignedIn()
        && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role'
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string;

      allow delete: if false;
    }

    // ==========================================
    // EGLISES
    // ==========================================

    match /churches/{churchId} {

      function validChurch(data) {

        return data.keys().hasAll([
          'ownerUid',
          'name',
          'username',
          'pastor',
          'country',
          'city',
          'address',
          'description',
          'logo',
          'cover',
          'createdAt'
        ])

        && data.keys().hasOnly([
          'ownerUid',
          'name',
          'username',
          'pastor',
          'country',
          'city',
          'address',
          'description',
          'logo',
          'cover',
          'createdAt'
        ])

        && data.ownerUid is string
        && data.name is string
        && data.name.size() > 0
        && data.username is string
        && data.username.matches('^[a-z0-9_.]+$')
        && data.pastor is string
        && data.country is string
        && data.city is string
        && data.address is string
        && data.description is string
        && data.logo is string
        && data.cover is string
        && data.createdAt is timestamp;
      }

      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && validChurch(request.resource.data);

      allow update: if isAdmin()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validChurch(request.resource.data);

      allow delete: if false;

      // ==========================================
      // PUBLICATIONS BIBLIQUES
      // ==========================================

      match /publications/{publicationId} {

        function isChurchOwner() {

          return isAdmin() &&
            get(/databases/$(database)/documents/churches/$(churchId))
              .data.ownerUid == request.auth.uid;
        }

        function publicationExists() {

          return exists(
            /databases/$(database)/documents/churches/$(churchId)/publications/$(publicationId)
          );
        }

        function validPublication(data) {

          return data.keys().hasAll([
            'title',
            'verse',
            'content',
            'authorUid',
            'createdAt',
            'updatedAt'
          ])

          && data.keys().hasOnly([
            'title',
            'verse',
            'content',
            'authorUid',
            'createdAt',
            'updatedAt'
          ])

          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 200
          && data.verse is string
          && data.verse.size() > 0
          && data.verse.size() <= 300
          && data.content is string
          && data.content.size() > 0
          && data.content.size() <= 20000
          && data.authorUid is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
        }

        allow read: if isSignedIn();

        allow create: if isChurchOwner()
          && validPublication(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isChurchOwner()
          && validPublication(request.resource.data)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isChurchOwner();

        // ==========================================
        // LIKES FIREBASE
        // ==========================================

        match /likes/{userId} {

          allow read: if isSignedIn()
            && publicationExists();

          allow create: if isSignedIn()
            && publicationExists()
            && request.auth.uid == userId

            && request.resource.data.keys().hasAll([
              'createdAt'
            ])

            && request.resource.data.keys().hasOnly([
              'createdAt'
            ])

            && request.resource.data.createdAt == request.time;

          allow delete: if isSignedIn()
            && request.auth.uid == userId;

          allow update: if false;
        }

        // ==========================================
        // COMMENTAIRES FIREBASE
        // ==========================================

        match /comments/{commentId} {

          function validComment(data) {

            return data.keys().hasAll([
              'authorUid',
              'authorName',
              'content',
              'createdAt'
            ])

            && data.keys().hasOnly([
              'authorUid',
              'authorName',
              'content',
              'createdAt'
            ])

            && data.authorUid is string

            && data.authorUid == request.auth.uid

            && data.authorName is string

            && data.authorName.size() > 0

            && data.authorName ==
              get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.name

            && data.content is string

            && data.content.size() > 0

            && data.content.size() <= 2000

            && data.content.matches('(?s).*\\S.*')

            && data.createdAt == request.time;
          }

          allow read: if isSignedIn()
            && publicationExists();

          allow create: if isSignedIn()
            && publicationExists()
            && validComment(request.resource.data);

          allow delete: if isSignedIn()
            && (
              resource.data.authorUid == request.auth.uid
              || isChurchOwner()
            );

          allow update: if false;
        }
      }

      // ==========================================
      // ABONNEMENTS
      // ==========================================

      match /followers/{userId} {

        allow read: if isSignedIn()
          && (
            request.auth.uid == userId ||
            get(/databases/$(database)/documents/churches/$(churchId))
              .data.ownerUid == request.auth.uid
          );

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/churches/$(churchId))
          && request.resource.data.keys().hasOnly(['followedAt'])
          && request.resource.data.followedAt == request.time;

        allow delete: if isSignedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }
    }
  }
}